+def _destination_refreshed_departure_source(
+    source_entries,
+    *,
+    origin_location_id,
+    destination_location_id,
+    destination_location,
+):
+    """Return one exact startup-refreshed source, or None if unprovable."""
+    if not isinstance(source_entries, list) or not isinstance(
+        destination_location, dict
+    ):
+        return None
+    if str(destination_location.get("locationId", "")) != str(
+        destination_location_id
+    ):
+        return None
+
+    prefix = "Current Location:\n"
+    matches = []
+    for index, message in enumerate(source_entries):
+        if not isinstance(message, dict) or message.get("role") != "system":
+            continue
+        content = message.get("content")
+        if not (
+            isinstance(content, str)
+            and content.startswith(prefix)
+            and content.endswith("\n")
+        ):
+            continue
+        try:
+            projected = json.loads(content[len(prefix) : -1])
+        except (TypeError, ValueError):
+            continue
+        if not isinstance(projected, dict):
+            continue
+        if content != prefix + json.dumps(
+            projected, separators=(",", ":")
+        ) + "\n":
+            continue
+        if str(projected.get("locationId", "")) == str(origin_location_id):
+            matches.append(index)
+
+    if len(matches) != 1:
+        return None
+
+    destination_projection = {
+        key: value
+        for key, value in destination_location.items()
+        if key != "adventureSummary"
+    }
+    refreshed = copy.deepcopy(source_entries)
+    refreshed[matches[0]] = {
+        "role": "system",
+        "content": prefix
+        + json.dumps(destination_projection, separators=(",", ":"))
+        + "\n",
+    }
+    return refreshed
+
