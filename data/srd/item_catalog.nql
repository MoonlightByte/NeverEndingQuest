item type "itemdef:srd/holy-symbol-amulet" named "Holy Symbol (Amulet)" {
 description "A Holy Symbol takes one of the forms in the Holy Symbol table and is bejeweled or painted to channel divine magic. A Cleric or Paladin can use a Holy Symbol as a Spellcasting Focus. The table indicates whether a Holy Symbol needs to be held, worn, or borne on fabric (such as a tabard or banner) or a Shield. This form: worn or held.";
 kind "equipment"; subtype "amulet";
 magical false; consumable false;
 equipment "gear:worn";
 price "gold" 5 per 1;
}
item type "itemdef:srd/holy-symbol-emblem" named "Holy Symbol (Emblem)" {
 description "A Holy Symbol takes one of the forms in the Holy Symbol table and is bejeweled or painted to channel divine magic. A Cleric or Paladin can use a Holy Symbol as a Spellcasting Focus. The table indicates whether a Holy Symbol needs to be held, worn, or borne on fabric (such as a tabard or banner) or a Shield. This form: borne on fabric or a Shield.";
 kind "equipment"; subtype "other";
 magical false; consumable false;
 equipment "gear:worn";
 price "gold" 5 per 1;
}
item type "itemdef:srd/holy-symbol-reliquary" named "Holy Symbol (Reliquary)" {
 description "A Holy Symbol takes one of the forms in the Holy Symbol table and is bejeweled or painted to channel divine magic. A Cleric or Paladin can use a Holy Symbol as a Spellcasting Focus. The table indicates whether a Holy Symbol needs to be held, worn, or borne on fabric (such as a tabard or banner) or a Shield. This form: held.";
 kind "equipment"; subtype "other";
 magical false; consumable false;
 equipment "gear:worn";
 price "gold" 5 per 1;
}
