{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module items",
  "description": "Items a module authors for its locations' lootItems (P3a). Typed by itemKey under the module's namespace; the host builds each catalog id as itemdef:module/<namespace>/<itemKey>.",
  "type": "object",
  "properties": {
    "format": { "const": "neq-module-items" },
    "version": { "const": 1 },
    "namespace": { "type": "string", "pattern": "^[a-z0-9_]+$", "not": { "enum": ["srd", "row"] } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemKey": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "kind": { "enum": ["equipment", "consumable", "miscellaneous"] },
          "magical": { "type": "boolean" },
          "consumable": { "type": "boolean" },
          "equipment": { "enum": ["gear:worn", null] }
        },
        "required": ["itemKey", "name", "kind", "magical", "consumable", "equipment"]
      }
    }
  },
  "required": ["format", "version", "namespace", "items"]
}
