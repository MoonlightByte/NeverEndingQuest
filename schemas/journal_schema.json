{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "In-world calendar date from worldConditions: '<year> <month> <day>', e.g. '1492 Springmonth 1'. Not an ISO date."
            },
            "time": {
              "type": "string",
              "description": "In-world time of day from worldConditions, 'HH:MM:SS', with no offset. Not an RFC 3339 time."
            },
            "location": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["date", "time", "location", "summary"]
        }
      }
    },
    "required": ["entries"]
  }