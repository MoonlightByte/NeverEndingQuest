{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "areaName": { "type": "string" },
      "areaId": { "type": "string" },
      "areaDescription": { "type": "string" },
      "areaType": { "type": "string" },
      "dangerLevel": { "type": "string" },
      "recommendedLevel": { "type": "integer" },
      "locations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "locationId": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "coordinates": { "type": "string" },
            "connectivity": {
              "type": "array",
              "items": { "type": "string" }
            },
            "lootItems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "itemKey": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                  "quantity": { "type": "integer", "minimum": 1 }
                },
                "required": ["itemKey", "quantity"],
                "additionalProperties": false
              },
              "description": "Typed loot that can be taken here: items of this module's module_items.json, by itemKey. Found under the same conditions as the lootTable or dcChecks entry that names it."
            }
          },
          "required": ["locationId", "name", "description"]
        }
      }
    },
    "required": ["areaName", "areaId", "locations"]
  }