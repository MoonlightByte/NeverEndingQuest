{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storage Action Schema",
  "description": "Schema for one storage operation or one atomic set of storage operations",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create_storage",
        "store_item",
        "retrieve_item",
        "store_currency",
        "retrieve_currency",
        "store_ammunition",
        "retrieve_ammunition",
        "view_storage"
      ]
    },
    "character": {"type": "string"},
    "storage_id": {"type": "string"},
    "storage_type": {
      "type": "string",
      "enum": ["chest", "lockbox", "barrel", "crate", "strongbox"]
    },
    "storage_name": {"type": "string"},
    "location_id": {"type": "string"},
    "location_description": {"type": "string"},
    "item_name": {"type": "string"},
    "quantity": {"type": "integer", "minimum": 1},
    "denomination": {
      "type": "string",
      "enum": ["gold", "silver", "copper"]
    },
    "ammunition_name": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "item_name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1}
        },
        "required": ["item_name", "quantity"]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create_storage",
              "store_item",
              "retrieve_item",
              "store_currency",
              "retrieve_currency",
              "store_ammunition",
              "retrieve_ammunition"
            ]
          },
          "character": {"type": "string"},
          "storage_id": {"type": "string"},
          "storage_type": {
            "type": "string",
            "enum": ["chest", "lockbox", "barrel", "crate", "strongbox"]
          },
          "storage_name": {"type": "string"},
          "location_id": {"type": "string"},
          "location_description": {"type": "string"},
          "item_name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "denomination": {
            "type": "string",
            "enum": ["gold", "silver", "copper"]
          },
          "ammunition_name": {"type": "string", "minLength": 1},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "item_name": {"type": "string"},
                "quantity": {"type": "integer", "minimum": 1}
              },
              "required": ["item_name", "quantity"]
            }
          }
        },
        "required": ["action", "character"],
        "allOf": [
          {
            "if": {
              "required": ["action"],
              "properties": {"action": {"const": "create_storage"}}
            },
            "then": {"required": ["storage_type", "location_description"]}
          },
          {
            "if": {
              "required": ["action"],
              "properties": {"action": {"const": "store_item"}}
            },
            "then": {
              "anyOf": [
                {"required": ["item_name", "quantity"]},
                {"required": ["items"]}
              ]
            }
          },
          {
            "if": {
              "required": ["action"],
              "properties": {"action": {"const": "retrieve_item"}}
            },
            "then": {
              "anyOf": [
                {"required": ["storage_id", "item_name", "quantity"]},
                {"required": ["storage_id", "items"]}
              ]
            }
          },
          {
            "if": {
              "required": ["action"],
              "properties": {
                "action": {"enum": ["store_currency", "retrieve_currency"]}
              }
            },
            "then": {"required": ["denomination", "quantity"]}
          },
          {
            "if": {
              "required": ["action"],
              "properties": {
                "action": {"enum": ["store_ammunition", "retrieve_ammunition"]}
              }
            },
            "then": {"required": ["ammunition_name", "quantity"]}
          },
          {
            "if": {
              "required": ["action"],
              "properties": {
                "action": {"enum": ["retrieve_currency", "retrieve_ammunition"]}
              }
            },
            "then": {"required": ["storage_id"]}
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "required": ["action", "character"],
      "not": {"required": ["operations"]}
    },
    {
      "required": ["operations"],
      "not": {"required": ["action"]}
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["action"],
        "properties": {"action": {"const": "create_storage"}}
      },
      "then": {"required": ["storage_type", "location_description"]}
    },
    {
      "if": {
        "required": ["action"],
        "properties": {"action": {"const": "store_item"}}
      },
      "then": {
        "anyOf": [
          {"required": ["item_name", "quantity"]},
          {"required": ["items"]}
        ]
      }
    },
    {
      "if": {
        "required": ["action"],
        "properties": {"action": {"const": "retrieve_item"}}
      },
      "then": {
        "anyOf": [
          {"required": ["storage_id", "item_name", "quantity"]},
          {"required": ["storage_id", "items"]}
        ]
      }
    },
    {
      "if": {
        "required": ["action"],
        "properties": {
          "action": {"enum": ["store_currency", "retrieve_currency"]}
        }
      },
      "then": {"required": ["denomination", "quantity"]}
    },
    {
      "if": {
        "required": ["action"],
        "properties": {
          "action": {"enum": ["store_ammunition", "retrieve_ammunition"]}
        }
      },
      "then": {"required": ["ammunition_name", "quantity"]}
    },
    {
      "if": {
        "required": ["action"],
        "properties": {
          "action": {"enum": ["retrieve_currency", "retrieve_ammunition"]}
        }
      },
      "then": {"required": ["storage_id"]}
    }
  ]
}
