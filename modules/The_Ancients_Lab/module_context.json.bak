    "archivist_automaton": {
      "name": "Archivist Automaton",
      "role": "",
      "faction": "",
      "description": "A semi-sapient dwarven automaton assigned to monitor and record the cell’s experiments. Scarred and flickering, it is conflicted—its primary programming to help, but secondary instructions to prevent any subject's escape.",
